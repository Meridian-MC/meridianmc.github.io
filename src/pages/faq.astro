---
import Base from "../layouts/Base.astro";
import Toc from "../components/Toc.astro";
import Callout from "../components/Callout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { DISCORD_INVITE_URL } from "../consts";

const sections = [
  { href: "#world", label: "The world" },
  { href: "#starting", label: "Getting started" },
  { href: "#economy", label: "Economy" },
];
---

<Base
  title="FAQ · Meridian"
  description="Frequently asked questions about the Meridian Minecraft server: the world, the Nether and End, PvP, the whitelist, getting started, and how the economy works."
  path="/faq"
>
<main class="doc faq">
  <h1>FAQ</h1>
  <p class="lead">Short answers to the questions that come up most. Live economic data is on the <a href="/economy">Economy</a> page; the binding rules are in the <a href="/rules">Rulebook</a>.</p>

  <Toc sections={sections} />

  <FaqAccordion />

  <Callout>Still stuck? Ask in <a href={DISCORD_INVITE_URL} rel="noopener">our Discord</a>.</Callout>
</main>
</Base>
