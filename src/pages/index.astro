---
import Base from "../layouts/Base.astro";
import ServerStatus from "../components/ServerStatus.tsx";
import { SERVER_ADDRESS, DISCORD_INVITE_CODE, DISCORD_INVITE_URL, MAP_URL, SERVER_VERSION, CLIENT_MIN_VERSION } from "../consts";

// The homepage is a front door, not a manual. Six mechanics, one line each,
// every one of them a link to the page that explains it.
//
// These cards deliberately carry no image. The previous version gave each one a
// 16:9 screenshot slot, which meant six empty frames were more than half the
// page, and unequal card widths pushed the titles out of line with each other.
// CivMC and Minehut both do icon plus title plus one line, aligned, and it
// reads far better than fake asymmetry around images that do not exist yet.
// The page gets its one image moment from the world map below, which is real.
const features = [
  { icon: "crown", title: "Nations", href: "/lands", cta: "Lands guide",
    line: "Claim chunks to protect what you build, then group lands into nations with capitals, taxes and diplomacy." },
  { icon: "emerald", title: "Economy", href: "/economy", cta: "Live data",
    line: "Chest shops set most prices. The server shop buys ore at a floor price that falls permanently as it buys." },
  { icon: "diamond_sword", title: "Combat", href: "/rules#pvp", cta: "The rules",
    line: "Crystal PvP and one-shot setups are banned. There is no keep-inventory, and your drops are yours alone for ten minutes." },
  { icon: "enchanted_book", title: "Vanilla+", href: "/faq", cta: "FAQ",
    line: "Pull an enchantment off a tool as a book, brew with fermenting and barrel aging, bottle experience and trade it." },
  { icon: "trial_key", title: "Rewards", href: "/vote", cta: "How voting works",
    line: "Vote on four sites a day and open crates for gear, materials and templates. Neither pays cash." },
  { icon: "crossbow", title: "Warfare", href: "/war", cta: "Warfare document",
    line: "Wars are declared through staff and fought over capture points until one side yields." },
];
---

<Base
  title="Meridian"
  description="Meridian (MMC) is a Vanilla+ survival Minecraft server built on nations, economy and warfare. Connect at meridian-mc.net."
  ogTitle="Meridian Vanilla+ Minecraft Server"
  ogDescription="A Vanilla+ survival server built on nations, economy and warfare. Connect at meridian-mc.net."
  path="/"
  bodyClass="bg"
>
<main class="w-full max-w-none p-0">
  <!-- HERO. The world, the name, the address, and whether it is up. Nothing
       else: everything a visitor needs in order to decide, and no more. -->
  <section class="relative flex min-h-[clamp(420px,64vh,580px)] items-end overflow-hidden">
    <div class="hero-world" aria-hidden="true"></div>

    <div class="relative mx-auto w-full max-w-[960px] px-5 pt-24 pb-14 sm:px-8 lg:pb-16">
      <div class="rise">
        <h1 class="m-0">
          <img class="wordmark w-[min(78vw,430px)]" src="/assets/wordmark.png" alt="Meridian" width="820" height="136" fetchpriority="high" />
        </h1>

        <p class="mt-6 max-w-[46ch] text-[1.08rem] leading-relaxed text-ink-2">
          A Vanilla+ survival server built on nations, economy and warfare.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-4">
          <button class="ip-box mc-btn" type="button" data-copy={SERVER_ADDRESS} aria-label={`Copy server address ${SERVER_ADDRESS}`}>
            <span class="ip">{SERVER_ADDRESS}</span>
            <svg class="copy-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>

          <a class="dbtn" href={DISCORD_INVITE_URL} rel="noopener" data-discord-invite={DISCORD_INVITE_CODE}>
            <svg class="dw-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09-.01-.02-.04-.03-.07-.03-1.5.26-2.93.71-4.27 1.33-.01 0-.02.01-.03.02-2.72 4.07-3.47 8.03-3.1 11.95 0 .02.01.04.03.05 1.8 1.32 3.53 2.12 5.24 2.65.03.01.06 0 .07-.02.4-.55.76-1.13 1.07-1.74.02-.04 0-.08-.04-.09-.57-.22-1.11-.48-1.64-.78-.04-.02-.04-.08-.01-.11.11-.08.22-.17.33-.25.02-.02.05-.02.07-.01 3.44 1.57 7.15 1.57 10.55 0 .02-.01.05-.01.07.01.11.09.22.17.33.26.04.03.04.09-.01.11-.52.31-1.07.56-1.64.78-.04.01-.05.06-.04.09.32.61.68 1.19 1.07 1.74.03.02.06.03.09.02 1.72-.53 3.45-1.33 5.25-2.65.02-.01.03-.03.03-.05.44-4.53-.73-8.46-3.1-11.95-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12 0-1.17.84-2.12 1.89-2.12 1.06 0 1.9.96 1.89 2.12 0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12 0-1.17.84-2.12 1.89-2.12 1.06 0 1.9.96 1.89 2.12 0 1.17-.83 2.12-1.89 2.12z"/></svg>
            <span class="dbtn-label">Discord</span>
            <span class="dbtn-count"><b class="dw-total">0</b> members</span>
          </a>

        </div>

        <div class="hero-meta mt-5">
          <ServerStatus client:load />
          <span class="hero-meta-sep" aria-hidden="true"></span>
          <p class="font-mono text-[0.78rem] text-ink-3">Java {CLIENT_MIN_VERSION}&ndash;{SERVER_VERSION}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto w-full max-w-[960px] px-5 sm:px-8">
    <section class="pt-16" id="mechanics">
      <div class="matrix fgrid mt-2">
        {features.map((f) => (
          <a class="fcard" href={f.href}>
            <div class="fcard-head">
              <img class="spec-ico" src={`/assets/mc/${f.icon}.png`} alt="" width="34" height="34" />
              <h2>{f.title}</h2>
            </div>
            <p>{f.line}</p>
            <span class="fcard-go">{f.cta}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- The one image that carries a section, and it is real: the full
         squaremap render of the actual world, with the live totals read off
         the same server beside it. -->
    <section class="pt-20" id="world">
      <h2 class="font-display text-[1.42rem] tracking-[-0.015em]">One world, 10,000 blocks across</h2>
      <div class="step-rule mt-4"></div>

      <div class="worldshow mt-6">
        <a class="ws-map" href={MAP_URL} target="_blank" rel="noopener" aria-label="Open the live map">
          <img src="/assets/worldmap.jpg" alt="Top-down render of the Meridian world" width="1100" height="1101" loading="lazy" />
          <span class="ws-open">Open the live map</span>
        </a>
        <div class="ws-stats stat-row pulse-stats" data-slot="pulse-stats"></div>
      </div>
    </section>

    <section class="pt-20 pb-24" id="activity">
      <h2 class="font-display text-[1.42rem] tracking-[-0.015em]">Latest</h2>
      <div class="step-rule mt-4"></div>
      <div class="pulse-feed mt-6" data-slot="pulse-feed"></div>
    </section>
  </div>
</main>
</Base>
