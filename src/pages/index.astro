---
import Base from "../layouts/Base.astro";
import PluginRegistry from "../components/PluginRegistry.astro";
import { SERVER_ADDRESS, DISCORD_INVITE_CODE, DISCORD_INVITE_URL } from "../consts";
---

<Base
  title="Meridian · Minecraft Server"
  description="Meridian (MMC) is a Vanilla+ survival Minecraft server built on land claims, nations, warfare, and a player-run economy. Connect at meridian-mc.net."
  ogTitle="Meridian Vanilla+ Minecraft Server"
  ogDescription="A Vanilla+ survival server built on land claims, nations, warfare, and a player-run economy. Connect at meridian-mc.net."
  path="/"
  bodyClass="bg"
>
<main>
  <section class="hero">
    <h1>Meridian</h1>
    <p class="tagline">A Vanilla+ survival server built on land claims, nations, warfare, and a player-run economy. Claim land, form a nation, and defend it.</p>

    <div class="ip-box" data-copy={SERVER_ADDRESS} role="button" tabindex="0">
      <div>
        <div class="ip">{SERVER_ADDRESS}</div>
      </div>
      <svg class="copy-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    </div>
    <div class="sub-line">Java Edition &nbsp;&middot;&nbsp; Version 26.2-1.8</div>

    <div class="srv" data-srv data-state="loading">
      <span class="srv-item srv-state"><span class="srv-dot"></span><span data-srv-state>Checking status&hellip;</span></span>
      <span class="srv-item" data-srv-players hidden><b data-srv-online>&mdash;</b>&thinsp;/&thinsp;<span data-srv-max>&mdash;</span> players</span>
      <span class="srv-item" data-srv-tps hidden><b data-srv-tps-v>&mdash;</b> TPS</span>
      <span class="srv-item" data-srv-uptime hidden>up <b data-srv-uptime-v>&mdash;</b></span>
    </div>
  </section>

  <section class="stack" id="community">
    <a class="discord-strip" href={DISCORD_INVITE_URL} rel="noopener" data-discord-invite={DISCORD_INVITE_CODE}>
      <svg class="ds-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09-.01-.02-.04-.03-.07-.03-1.5.26-2.93.71-4.27 1.33-.01 0-.02.01-.03.02-2.72 4.07-3.47 8.03-3.1 11.95 0 .02.01.04.03.05 1.8 1.32 3.53 2.12 5.24 2.65.03.01.06 0 .07-.02.4-.55.76-1.13 1.07-1.74.02-.04 0-.08-.04-.09-.57-.22-1.11-.48-1.64-.78-.04-.02-.04-.08-.01-.11.11-.08.22-.17.33-.25.02-.02.05-.02.07-.01 3.44 1.57 7.15 1.57 10.55 0 .02-.01.05-.01.07.01.11.09.22.17.33.26.04.03.04.09-.01.11-.52.31-1.07.56-1.64.78-.04.01-.05.06-.04.09.32.61.68 1.19 1.07 1.74.03.02.06.03.09.02 1.72-.53 3.45-1.33 5.25-2.65.02-.01.03-.03.03-.05.44-4.53-.73-8.46-3.1-11.95-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12 0-1.17.84-2.12 1.89-2.12 1.06 0 1.9.96 1.89 2.12 0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12 0-1.17.84-2.12 1.89-2.12 1.06 0 1.9.96 1.89 2.12 0 1.17-.83 2.12-1.89 2.12z"/></svg>
      <span class="ds-name">Discord</span>
      <span class="ds-count"><span class="ds-dot"></span><b class="dw-online">…</b>&nbsp;online <span class="ds-sep">/</span> <b class="dw-total">…</b>&nbsp;members</span>
      <span class="ds-join">Join</span>
    </a>
  </section>

  <section class="stack" id="plugins">
    <h2>Plugins</h2>
    <p class="section-intro">Meridian runs on <a href="https://papermc.io" rel="noopener">Paper</a>. These are the systems that define how it plays. Everything else it runs is listed below them.</p>

    <PluginRegistry />
  </section>
</main>
</Base>
