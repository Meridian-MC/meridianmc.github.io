---
import Base from "../layouts/Base.astro";
import PluginRegistry from "../components/PluginRegistry.astro";
import { SERVER_ADDRESS, DISCORD_INVITE_CODE, DISCORD_INVITE_URL } from "../consts";

// Deterministic pseudo-random embers so the build is reproducible (no Math.random at build time).
function seeded(seed: number) {
  let s = seed;
  return () => { s = (s * 9301 + 49297) % 233280; return s / 233280; };
}
const rand = seeded(42);
const embers = Array.from({ length: 14 }, () => ({
  x: (rand() * 100).toFixed(1) + "%",
  size: (2.5 + rand() * 3.5).toFixed(1) + "px",
  dur: (7 + rand() * 8).toFixed(1) + "s",
  delay: (rand() * -14).toFixed(1) + "s",
  drift: (rand() * 60 - 30).toFixed(0) + "px",
}));
---

<Base
  title="Meridian · Minecraft Server"
  description="Meridian (MMC) is a Vanilla+ survival Minecraft server built on land claims, nations, warfare, and a player-run economy. Connect at meridian-mc.net."
  ogTitle="Meridian Vanilla+ Minecraft Server"
  ogDescription="A Vanilla+ survival server built on land claims, nations, warfare, and a player-run economy. Connect at meridian-mc.net."
  path="/"
  bodyClass="bg"
>
<main>
  <section class="hero">
    <div class="embers" aria-hidden="true">
      {embers.map((e) => (
        <span style={`--x:${e.x};--size:${e.size};--dur:${e.dur};--delay:${e.delay};--drift:${e.drift}`}></span>
      ))}
    </div>
    <h1>Meridian</h1>
    <p class="tagline">A Vanilla+ survival server built on land claims, nations, warfare, and a player-run economy. Claim land, form a nation, and defend it.</p>

    <div class="ip-box" data-copy={SERVER_ADDRESS} role="button" tabindex="0">
      <div>
        <div class="ip">{SERVER_ADDRESS}</div>
      </div>
      <svg class="copy-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    </div>
    <div class="sub-line">Java Edition &nbsp;&middot;&nbsp; Version 26.2-1.8</div>

    <div class="srv" data-srv data-state="loading">
      <span class="srv-item srv-state"><span class="srv-dot"></span><span data-srv-state>Checking status&hellip;</span></span>
      <span class="srv-item" data-srv-players hidden><b data-srv-online>&mdash;</b>&thinsp;/&thinsp;<span data-srv-max>&mdash;</span> players</span>
      <span class="srv-item" data-srv-tps hidden><b data-srv-tps-v>&mdash;</b> TPS</span>
      <span class="srv-item" data-srv-uptime hidden>up <b data-srv-uptime-v>&mdash;</b></span>
    </div>
  </section>

  <section class="stack" id="community">
    <a class="discord-strip" href={DISCORD_INVITE_URL} rel="noopener" data-discord-invite={DISCORD_INVITE_CODE}>
      <svg class="ds-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09-.01-.02-.04-.03-.07-.03-1.5.26-2.93.71-4.27 1.33-.01 0-.02.01-.03.02-2.72 4.07-3.47 8.03-3.1 11.95 0 .02.01.04.03.05 1.8 1.32 3.53 2.12 5.24 2.65.03.01.06 0 .07-.02.4-.55.76-1.13 1.07-1.74.02-.04 0-.08-.04-.09-.57-.22-1.11-.48-1.64-.78-.04-.02-.04-.08-.01-.11.11-.08.22-.17.33-.25.02-.02.05-.02.07-.01 3.44 1.57 7.15 1.57 10.55 0 .02-.01.05-.01.07.01.11.09.22.17.33.26.04.03.04.09-.01.11-.52.31-1.07.56-1.64.78-.04.01-.05.06-.04.09.32.61.68 1.19 1.07 1.74.03.02.06.03.09.02 1.72-.53 3.45-1.33 5.25-2.65.02-.01.03-.03.03-.05.44-4.53-.73-8.46-3.1-11.95-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12 0-1.17.84-2.12 1.89-2.12 1.06 0 1.9.96 1.89 2.12 0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12 0-1.17.84-2.12 1.89-2.12 1.06 0 1.9.96 1.89 2.12 0 1.17-.83 2.12-1.89 2.12z"/></svg>
      <span class="ds-name">Discord</span>
      <span class="ds-count"><span class="ds-dot"></span><b class="dw-online">…</b>&nbsp;online <span class="ds-sep">/</span> <b class="dw-total">…</b>&nbsp;members</span>
      <span class="ds-join">Join</span>
    </a>
  </section>

  <section class="stack" id="frontier">
    <h2>Frontier report</h2>
    <p class="section-intro">What's happening right now, rebuilt from live server data.</p>
    <div class="stat-row pulse-stats" data-slot="pulse-stats"></div>
    <div class="pulse-feed" data-slot="pulse-feed"></div>
  </section>

  <section class="stack" id="different">
    <h2>What's different here</h2>
    <p class="section-intro">The mechanics and rules that actually shape how Meridian plays.</p>

    <div class="bento">
      <article class="bcard b-land">
        <svg class="b-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-4Z"/><path d="M9 12l2 2 4-4"/></svg>
        <h3>Land claims &amp; nations</h3>
        <p>Claim chunks to protect your builds, then group with others into nations with capitals, taxes, and tracked diplomacy. Claims stay protected at all times, except during a staff-approved war.</p>
        <a href="/lands" class="b-link">Read the Lands guide</a>
      </article>

      <article class="bcard b-econ">
        <svg class="b-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="5.5"/><circle cx="15.5" cy="15.5" r="5.5"/><path d="M8 5.5v5M5.5 8h5"/></svg>
        <h3>Player-run economy</h3>
        <p>Chest shops are the real market. The server only steps in for a small Buy/Sell counter, priced so trading with other players always wins.</p>
        <a href="/economy" class="b-link">See live economy data</a>
      </article>

      <article class="bcard b-pvp">
        <svg class="b-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 17.5 21 11l-3-3-6.5 6.5M6.5 9.5 3 6l3-3 3.5 3.5M6 18l-3 3M9 15l-6 6M15 9l6-6"/></svg>
        <h3>Fair-State PvP</h3>
        <p>Standard combat only: swords, axes, bows, shields, potions. No one-shot combos, no crystal PvP, no offensive machinery, no lockdown traps. Real stakes, without the cheese.</p>
      </article>

      <article class="bcard b-world">
        <svg class="b-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>
        <h3>10,000 &times; 10,000 world</h3>
        <p>A real border, not an infinite void. Room to spread out without every land being a day's walk from another.</p>
      </article>

      <article class="bcard b-end">
        <svg class="b-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="12" rx="9" ry="5.5"/><circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none"/></svg>
        <h3>The End stays closed</h3>
        <p>Elytra and dragon trophies enter the economy only through what players already had. Real scarcity, on purpose.</p>
      </article>

      <article class="bcard b-nether">
        <svg class="b-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c-1.2 2-3.2 3.6-3.2 6.2a3.2 3.2 0 0 0 6.4 0c0-1-.4-1.8-.9-2.5"/><path d="M9.5 13c-1.2 1.5-2.5 3-2.5 5a5 5 0 0 0 10 0c0-1.4-.5-2.6-1.1-3.6"/></svg>
        <h3>The Nether resets monthly</h3>
        <p>About 1,250 blocks wide by design, so netherite and blaze rods stay properly scarce. Wiped on the 1st of every month so it can't be stripped bare for good.</p>
      </article>

      <article class="bcard b-guard">
        <svg class="b-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-4Z"/><circle cx="12" cy="11" r="2.6"/><path d="M12 8.4v-.1M12 13.6v.1M9.4 11h-.1M14.7 11h-.1"/></svg>
        <h3>Anti-cheat &amp; hidden ores</h3>
        <p>GrimAC watches movement and combat. Ores stay invisible to your client until you're near them, so x-ray shows you nothing to see.</p>
      </article>
    </div>
  </section>

  <section class="stack" id="plugins">
    <h2>Plugins</h2>
    <p class="section-intro">Meridian runs on <a href="https://papermc.io" rel="noopener">Paper</a>. These are the systems that define how it plays. Everything else it runs is listed below them.</p>

    <PluginRegistry />
  </section>
</main>
</Base>
