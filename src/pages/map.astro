---
import Base from "../layouts/Base.astro";
import { MAP_URL } from "../consts";
---

<Base
  title="Live Map"
  description="A live, top-down view of the Meridian world: claims, nation borders, and where towns have gone up."
  path="/map"
>
<div class="map-frame-wrap">
  <div class="map-head-float">
    <h1>Live Map</h1>
    <a href={MAP_URL} rel="noopener">Open in a new tab</a>
  </div>
  <iframe
    src={MAP_URL}
    title="Meridian live map"
    loading="lazy"
    referrerpolicy="no-referrer"
  ></iframe>
</div>
</Base>
