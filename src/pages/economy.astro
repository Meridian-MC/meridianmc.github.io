---
import Base from "../layouts/Base.astro";
---

<Base
  title="Economy · Meridian"
  description="A live read on the Meridian server economy: the Meridian Economic Index, money supply, trade volume, and prices."
  path="/economy"
  analytics
>
<main class="doc">
  <h1>Economy</h1>
  <div class="data-stale" data-stale hidden></div>

  <div class="analytics" data-analytics>
    <!-- Ordered the way an economic report is ordered: the rules of the
         economy first, then money, prices, activity and distribution. Each
         figure appears exactly once, with the chart it belongs to. -->
    <section id="flow">
      <h2>How money works</h2>
      <p>The currency of this server is Gold (G). Gold can be obtained through mining, voting, or trading with players. There is no server shop.</p>
      <p>Gold is used to purchase land claims, pay upkeep, establish nations, and for various other expenses.</p>
      <p>Personal banks do not exist. Gold can only be stored in chests and land banks.</p>
    </section>

    <section id="money">
      <h2>Money</h2>
      <div class="stat-row" data-slot="stat-money"></div>
      <div class="chart">
        <h3>Money supply</h3>
        <div class="c-sub">Total currency held by players.</div>
        <div data-slot="supply-chart"></div>
      </div>
    </section>

    <section id="prices">
      <h2>Prices</h2>
      <div class="stat-row" data-slot="stat-prices"></div>
      <div class="chart">
        <h3>Price index</h3>
        <div data-slot="price-chart"></div>
      </div>
      <div data-slot="item-table"></div>
      <h3>Daily range</h3>
      <div class="candles" data-slot="candles"></div>
    </section>

    <section id="trade">
      <h2>Trade</h2>
      <div class="stat-row" data-slot="stat-trade"></div>
      <div class="chart">
        <h3>Trade volume</h3>
        <div class="c-sub">Value moving between players and through shops each day.</div>
        <div data-slot="volume-chart"></div>
      </div>
    </section>

  </div>
</main>
</Base>
