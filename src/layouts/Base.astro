---
import { SITE_NAME, MAP_URL } from "../consts";

export interface Props {
  title: string;
  description: string;
  path: string;            // "/", "/rules", "/lands", ...
  ogTitle?: string;
  ogDescription?: string;
  bodyClass?: string;
  analytics?: boolean;      // include assets/analytics.js
}

const {
  title,
  description,
  path,
  ogTitle = title,
  ogDescription = description,
  bodyClass,
  analytics = false,
} = Astro.props;

const NAV = [
  { href: "/", label: "Home" },
  { href: "/rules", label: "Rules" },
  { href: "/lands", label: "Lands" },
  { href: "/nations", label: "Nations" },
  { href: "/war", label: "Warfare" },
  { href: "/economy", label: "Economy" },
  { href: "/faq", label: "FAQ" },
  { href: "/commands", label: "Commands" },
  // The map lives on its own subdomain and opens in a new tab: squaremap sends
  // a 4-hour cache header, so anything embedded here shows a stale world.
  { href: MAP_URL, label: "Live Map", external: true },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600;700;800&family=Syne:wght@700;800&family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<link rel="stylesheet" href="/assets/style.css">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" href="/favicon.ico" sizes="32x32" type="image/x-icon">
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE_NAME}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:url" content={`https://meridian-mc.net${path}`}>
<meta property="og:image" content="https://meridian-mc.net/assets/og.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0b0b0c">
</head>
<body class={bodyClass}>
<header class="site-header">
  <nav class="nav-inner">
    <a href="/" class="brand"><span class="mark">M</span> {SITE_NAME}</a>
    <button class="nav-toggle" aria-label="Menu">☰</button>
    <div class="nav-links">
      {NAV.map((item) => (
        <a
          href={item.href}
          class={item.href === path ? "active" : undefined}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener" : undefined}
        >{item.label}</a>
      ))}
    </div>
    <button class="cmdk-trigger" data-cmdk-open type="button" aria-label="Search Meridian">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <span class="cmdk-kbd">&#8984;K</span>
    </button>
  </nav>
  <div class="ticker-wrap" data-slot="ticker"></div>
</header>

<div class="cmdk-overlay" data-cmdk hidden>
  <div class="cmdk-box" role="dialog" aria-modal="true" aria-label="Search Meridian">
    <div class="cmdk-input-row">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="text" class="cmdk-input" data-cmdk-input placeholder="Jump to a page or section&hellip;" autocomplete="off" spellcheck="false">
      <kbd class="cmdk-esc">esc</kbd>
    </div>
    <div class="cmdk-results" data-cmdk-results></div>
  </div>
</div>

<slot />

<footer class="site-footer">
  <div class="f-name">{SITE_NAME}</div>
  <div class="f-legal">
    {path === "/"
      ? <>A Vanilla+ survival server running on <a href="https://papermc.io" rel="noopener">Paper</a>. Not affiliated with Mojang or Microsoft.</>
      : <>meridian-mc.net is not affiliated with Mojang or Microsoft.</>}
  </div>
  <div class="f-loc">Hosted in Vint Hill, Virginia.</div>
</footer>

<script is:inline>
  // Tried in order; the first that answers wins. Both are same-origin, so no
  // CORS is involved: /api/data.json is served by the Worker, which fetches
  // live figures from the game server and itself falls back to this same
  // committed copy. Listing /data.json here too covers the Worker being absent.
  window.MERIDIAN_DATA_URLS = ["/api/data.json", "/data.json"];
</script>
<script is:inline src="/assets/app.js"></script>
<script is:inline src="/assets/analytics.js"></script>
</body>
</html>
