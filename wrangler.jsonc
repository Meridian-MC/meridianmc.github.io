{
  "name": "meridianmc-github-io",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-03",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // dist/data.json exists as a static asset, and assets are served before the
    // Worker runs unless a path is listed here. Without this the Worker never
    // sees /data.json and the committed copy is always served instead of the
    // live one. Everything else still short-circuits to assets as normal.
    "run_worker_first": ["/data.json"]
  }
}
